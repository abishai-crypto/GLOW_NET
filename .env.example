# =====================================================================
# GLOW NET - Environment Variables Example
# Copy this file to .env or use environment variables in your server
# =====================================================================

# Database Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=glownet_db
DB_USER=root
DB_PASS=

# Application Settings
APP_ENV=production
APP_URL=http://localhost/glownet
APP_TIMEZONE=Africa/Dar_es_Salaam

# Master Admin Credentials (Used if seeding fresh database)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME="Master Admin (GLOW NET)"

# Payment Gateway Settings (ZenoPay Tanzania)
# Providers: sandbox | zenopay | azampay
PAYMENT_PROVIDER=sandbox
ZENOPAY_ACCOUNT_ID=
ZENOPAY_API_KEY=
ZENOPAY_SECRET_KEY=
