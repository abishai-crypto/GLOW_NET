# =====================================================================
# GLOW NET - Git Ignore Configuration
# =====================================================================

# 1. Environment & Sensitive Local Configurations
.env
.env.local
.env.*.local
config.local.php
*.key
*.pem
*.cert

# 2. Server & Temporary Files
*.log
error_log
access_log
temp/
tmp/
cache/

# 3. Archives & Distribution Builds
*.zip
*.tar.gz
*.rar
*.7z
# Packagers generated by build scripts
glownet_v*_packager.html

# 4. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 5. IDEs and Code Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# 6. Package Managers (Future expansions)
vendor/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
